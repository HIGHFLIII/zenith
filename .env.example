# Copy this file to .env in the same folder.
# These values are only for the database on your own computer.
# Do not use them on a public server. Do not commit the .env file.

# Name of the local database user.
POSTGRES_USER=zenith

# Password for that local database user.
# Use letters and numbers only, then put the same password in DATABASE_URL below.
POSTGRES_PASSWORD=zenith_dev_password

# Name of the local database.
POSTGRES_DB=zenith

# Port on your computer that PostgreSQL uses.
POSTGRES_PORT=5432

# Address the website uses when you run it on your computer
# and PostgreSQL is running in Docker.
DATABASE_URL=postgresql://zenith:zenith_dev_password@localhost:5432/zenith

# Optional Steam import. Leave these blank until you are ready.
# Create a key at https://steamcommunity.com/dev/apikey while logged into your Steam account.
# STEAM_ID is the 17-digit number in your profile address.
# Do not commit a real key. Do not paste the key into chat.
STEAM_API_KEY=
STEAM_ID=
